# -*- coding: utf-8 -*-
"""
arm_model.py (v2) - complete, buildable model of the ARC Season 2 Engineer arm
adapted from Wang et al., Actuators 2025, 14, 71.

Every part carries two shapes:  vis (detailed / vendor geometry, for the
assembly and renders) and chk (simplified solid used by the interference sweep).
Rigid bodies are built in local frames and placed by placements(); the same
frames are used by build_assembly.py to create Assembly-workbench joints.

Frame: X forward from chassis front bumper, Y left, Z up from Battlefield floor.

Y stack (centre planes, 3 mm CF plates):
    J1 DM-J4340 stator  -52.5 .. -105     |  J2 DM-J4340 stator +52.5 .. +105
    tower L  -51.0  (motor bolts on PCD50)|  tower R  +51.0
    J1 hub   -51.5 .. -47.0               |  J2 hub   +47.0 .. +51.5, journal D12
    upper L  -45.5                        |  upper R  +45.5  (6701 on J2 journal)
    rod 1    -42.0                        |
    rocker / level member -37.5 (+GT2 30T pulley -36..-25.5, 9 mm belt -35.25..-26.25)
                                          |  crank   +34.5
                                          |  rod AB  +29.0
    clevis L -23.5 (wrist)                |  clevis R +23.5
    forearm L -18.0                       |  forearm R +18.0
    servo (wrist, outboard)  -45 .. -86
"""
import math
import os
import FreeCAD as App
import Part
import hardware as H

V = App.Vector

# ----------------------------------------------------------------- kinematics
K = dict(SX=-160.0, SZ=215.0, L1=80.0, L2=340.0, L3=350.0, GRIP=151.0, DROP=20.0,
         V1_LEN=70.0, V1_ANG=192.0, DECK_Z=120.0)
T = 3.0
Y = dict(FL=-18.0, CL=-23.5, BELT=-30.75, ROCK=-37.5, ROD1=-42.0, UA=-45.5, TW=-51.0,
         RAB=29.0, CRANK=34.5)
# ---- gripper: curved jaws + Tr8x8 bidirectional lead-screw drive (head frame)
PAD_R, NOTCH, WRAP = 50.0, 12.0, 22.0   # donut-OD arc radius, pipe V-notch depth (90 deg), arc half-angle
PIPE_R = 26.7 / 2
O_PIPE = PIPE_R * math.sqrt(2) - NOTCH  # pad-face half gap when the V-notches hold the pipe
O_REF = O_PIPE         # jaw half-opening at which jaw bodies are modelled (pipe grip)
PIPE_JAW = 2 * O_PIPE  # 'jaw' value = gap between the arc-bottom pad faces at the TCP
LEAD = 8.0             # Tr8x8 4-start: free-running, so the spring motor can spin it open (R52)
Z_SCREW_T, Z_MOTOR_T = 32, 20     # 1.6:1 reduction motor -> screw (35 mm/s per jaw, finer grip force)
GT2_T = 30             # level-keeping pulleys: 30T so the D10.6 bore clears the tooth roots (20T left 0.1 mm)
UA_HUB_SCREWS = (30.0, 150.0, 270.0)   # J1 hub -> UA-L: 3x M3 on PCD20, clear of the PCD27 counterbores + dowels
HUB_R = 19.5           # J1/J2 output hub flange radius (counterbores on PCD27 need >= 2.5 mm wall)

# motor interface (from Damiao drawing + vendor STEP, model frame, angles atan2(z,x))
DM = dict(stator_pcd=50.0, stator_holes=(30, 90, 150, -30, -90, -150), stator_dowels=(75, -105),
          out_pcd=27.0, out_holes=(0, 60, 120, 180, -120, -60), out_dowel_pcd=24.0, out_dowels=(90, -30, -150),
          face=51.5)
M2006_HOLES = dict(pcd=18.4, ang=(1, 121, 241))

