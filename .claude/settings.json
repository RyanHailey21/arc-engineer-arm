{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git -C * push --force*)",
      "PowerShell(git -C * push -f*)",
      "PowerShell(git -C * push * --force*)",
      "PowerShell(git -C * push * -f)",
      "PowerShell(git -C * push * -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git -C * reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git -C * clean *)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/cad/tools/sync_on_open.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/cad/tools/hooks/release_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
