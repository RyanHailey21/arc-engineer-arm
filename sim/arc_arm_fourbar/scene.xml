      <inertial pos="0 0 0" mass="0.165" diaginertia="3.45e-3 3.45e-3 2.37e-5"/>
      <geom class="world" type="cylinder" size="0.01335 0.25" mass="0.165" rgba="0.8 0.15 0.15 1" condim="4" friction="0.8 0.02 0.002"/></body>
